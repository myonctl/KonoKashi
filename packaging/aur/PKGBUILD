# Public-release packaging candidate. See README.md before submitting.
# Maintainer: myonctl <158342900+myonctl@users.noreply.github.com>
pkgname=konokashi
pkgver=0.1.0beta1
pkgrel=1
_sdistver=0.1.0b1
pkgdesc='Local-first synchronized multilingual lyrics for Linux MPRIS players'
arch=('x86_64' 'aarch64')
options=('!debug')
url='https://github.com/myonctl/KonoKashi'
license=('PolyForm-Noncommercial-1.0.0')
depends=(
  'hicolor-icon-theme'
  'python>=3.11'
  'python<3.15'
  'pyside6>=6.8.2'
  'python-cutlet>=0.5.2'
  'python-fugashi>=1.5.2'
  'python-httpx>=0.28.1'
  'python-mutagen>=1.47'
  'pypinyin>=0.55'
  'python-pyicu>=2.16.2'
  'python-textual>=8.2.8'
  'python-tomlkit>=0.15.1'
  'python-unidic-lite>=1.0.8'
)
makedepends=('pybind11' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
optdepends=('playerctl: optional MPRIS debugging' 'pipewire: optional audio timing diagnostics')
source=("$pkgname-$_sdistver.tar.gz::https://github.com/myonctl/KonoKashi/releases/download/v0.1.0-beta.1/$pkgname-$_sdistver.tar.gz")
sha256sums=('c0727503df631741a1ebe1d8cdb1836363eb727c1930fea0e4ce921b327734d8')

build() {
  cd "$pkgname-$_sdistver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$_sdistver"
  python -m installer --destdir="$srcdir/test-root" --prefix=/usr dist/*.whl
  local test_site
  test_site="$(find "$srcdir/test-root/usr/lib" -type d -name site-packages -print -quit)"
  # Package smoke/regressions independent of Git-only repository documentation.
  PYTHONPATH="$test_site" QT_QPA_PLATFORM=offscreen python -m pytest \
    tests/test_package.py tests/test_lrc_parser.py tests/test_playback_clock.py \
    tests/test_playback_clock_native.py tests/test_romanization_adapters.py
}

package() {
  cd "$pkgname-$_sdistver"
  python -m installer --destdir="$pkgdir" --prefix=/usr dist/*.whl
  sed -i '1c#!/usr/bin/python' "$pkgdir/usr/bin/konokashi"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  sed -e 's|@KONOKASHI_EXECUTABLE@|konokashi|' \
      -e 's|@KONOKASHI_ICON@|io.github.myonctl.KonoKashi|' \
      src/konokashi/resources/io.github.myonctl.KonoKashi.desktop.in \
      > "$srcdir/io.github.myonctl.KonoKashi.desktop"
  install -Dm644 "$srcdir/io.github.myonctl.KonoKashi.desktop" \
    "$pkgdir/usr/share/applications/io.github.myonctl.KonoKashi.desktop"
  install -Dm644 src/konokashi/resources/io.github.myonctl.KonoKashi.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.myonctl.KonoKashi.svg"
  install -Dm644 src/konokashi/resources/io.github.myonctl.KonoKashi.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.myonctl.KonoKashi.metainfo.xml"
}
