# Local readiness candidate. See README.md before building or submitting.
# Maintainer: myonctl
pkgname=lyriflux
pkgver=1.0.0
pkgrel=1
pkgdesc='Local-first synchronized multilingual lyrics for Linux MPRIS players'
arch=('any')
url='https://github.com/myonctl/LyriFlux'
license=('LicenseRef-Proprietary')
depends=(
  'hicolor-icon-theme'
  'python>=3.11'
  'pyside6>=6.8.2'
  'python-cutlet>=0.5.2'
  'python-fugashi>=1.5.2'
  'python-httpx>=0.28.1'
  'python-mutagen>=1.47'
  'python-pypinyin>=0.55'
  'python-pyicu>=2.16.2'
  'python-textual>=8.2.8'
  'python-tomlkit>=0.15.1'
  'python-unidic-lite>=1.0.8'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
checkdepends=('python-pytest')
optdepends=('playerctl: optional MPRIS debugging' 'pipewire: optional audio timing diagnostics')
# No public release exists. Supply the reviewed local sdist alongside PKGBUILD.
# Replace this with the final immutable HTTPS release-asset URL before submission.
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('33fc7740a3a5e4c5e92104ac4a21671e1d8eaa45f510ceb59d1363a1db83c9a4')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  # Package smoke/regressions independent of Git-only repository documentation.
  PYTHONPATH=src QT_QPA_PLATFORM=offscreen python -m pytest \
    tests/test_package.py tests/test_lrc_parser.py tests/test_romanization_adapters.py
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" --prefix=/usr dist/*.whl
  sed -i '1c#!/usr/bin/python' "$pkgdir/usr/bin/lyriflux"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  sed -e 's|@LYRIFLUX_EXECUTABLE@|lyriflux|' \
      -e 's|@LYRIFLUX_ICON@|io.github.myonctl.LyriFlux|' \
      src/lyriflux/resources/io.github.myonctl.LyriFlux.desktop.in \
      > "$srcdir/io.github.myonctl.LyriFlux.desktop"
  install -Dm644 "$srcdir/io.github.myonctl.LyriFlux.desktop" \
    "$pkgdir/usr/share/applications/io.github.myonctl.LyriFlux.desktop"
  install -Dm644 src/lyriflux/resources/io.github.myonctl.LyriFlux.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.myonctl.LyriFlux.svg"
  install -Dm644 src/lyriflux/resources/io.github.myonctl.LyriFlux.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.myonctl.LyriFlux.metainfo.xml"
}
