# Companion dependency candidate for KonoKashi. See ../README.md.
# Maintainer: myonctl <158342900+myonctl@users.noreply.github.com>
pkgname=python-unidic-lite
pkgver=1.0.8
pkgrel=1
pkgdesc='Small UniDic dictionary package for Python'
arch=('any')
url='https://github.com/polm/unidic-lite'
license=('MIT' 'BSD-3-Clause')
depends=('python')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("unidic-lite-$pkgver.tar.gz::https://files.pythonhosted.org/packages/55/2b/8cf7514cb57d028abcef625afa847d60ff1ffbf0049c36b78faa7c35046f/unidic-lite-$pkgver.tar.gz")
sha256sums=('db9d4572d9fdd4d00a97949d4b0741ec480ee05a7e7e2e32f547500dae27b245')

build() {
  cd "unidic-lite-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "unidic-lite-$pkgver"
  python -m installer --destdir="$pkgdir" --prefix=/usr dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE.unidic \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.unidic"
}
